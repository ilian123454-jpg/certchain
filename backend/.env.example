# Копирайте като .env при стартиране без Docker. Всички стойности имат подразбиране за локална работа.
PORT=4000
DATABASE_URL=postgres://certchain:certchain@127.0.0.1:5432/certchain
RPC_URL=http://127.0.0.1:8545
# DEPLOYMENT_FILE=../contracts/deployments/localhost.json
JWT_SECRET=change-this-jwt-secret-at-least-32-characters
KEY_ENCRYPTION_SECRET=change-this-key-encryption-secret
LOG_SALT=change-this-salt
# Акаунт #0 на локалния Hardhat възел (публично известен, само за разработка)
ADMIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
PUBLIC_APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
